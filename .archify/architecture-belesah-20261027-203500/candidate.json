  "cards": [
    {
      "dot": "amber",
      "title": "Startup does not gate",
      "items": [
        "main() reads is_activated and is_meter, then BelesahApp.home is ScreenMainMeter on every branch",
        "ScreenActivation can write those flags and open ScreenMainCM, but no committed caller constructs it"
      ]
    },
    {
      "dot": "rose",
      "title": "Duplicated CM tree",
      "items": [
        "lib/version_cm mirrors version_meter screens, logic, PDF, and contracts",
        "ScreenMainCM is only referenced from ScreenActivation, which is itself unused from main"
      ]
    },
    {
      "dot": "violet",
      "title": "Tight hubs",
      "items": [
        "ScreenCalc (~788 lines) owns profile switching, formulas, cards, and PdfService static state",
        "Each profile has a near-copy price screen plus a LogicPrice that embeds the matching cut logic"
      ]
    }
  ]
